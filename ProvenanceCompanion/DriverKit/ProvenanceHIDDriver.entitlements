<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  DriverKit entitlements for ProvenanceCompanionDriverKit.dext

	  IMPORTANT: You must request the "com.apple.developer.driverkit" entitlement
	  from Apple Developer Portal (https://developer.apple.com/contact/request/driverkit/)
	  before building a distribution build. Development builds work without the approval.
	-->

	<!-- Required: identifies this as a DriverKit extension -->
	<key>com.apple.developer.driverkit</key>
	<true/>

	<!-- USB HID device family — allows claiming USB HID interface -->
	<key>com.apple.developer.driverkit.family.hid.device</key>
	<true/>

	<!-- HID EventService — allows posting HID events to IOHIDEventSystem -->
	<key>com.apple.developer.driverkit.family.hid.eventservice</key>
	<true/>

	<!--
	  USB transport entitlement (required to communicate with USB devices).
	  Add USB host entitlement once approved:
	    com.apple.developer.driverkit.transport.usb
	-->
	<key>com.apple.developer.driverkit.transport.usb</key>
	<true/>

	<!-- IOUserClient allow list — apps that can open a UserClient to this dext -->
	<!-- Add the Provenance main app bundle ID here to allow direct IPC -->
	<key>com.apple.developer.driverkit.userclient-access</key>
	<array>
		<string>org.provenance-emu.provenance</string>
		<string>org.provenance-emu.ProvenanceCompanion</string>
	</array>

	<!-- App sandbox (required for DriverKit extensions on iPadOS) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
