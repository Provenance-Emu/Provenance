<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  DriverKit entitlements for ProvenanceCompanionDriverKit.dext

	  IMPORTANT: You must request the "com.apple.developer.driverkit" entitlement
	  from Apple Developer Portal (https://developer.apple.com/contact/request/driverkit/)
	  before building a distribution build.

	  Re-add when approved:
	    com.apple.developer.driverkit
	    com.apple.developer.driverkit.family.hid.device
	    com.apple.developer.driverkit.family.hid.eventservice
	    com.apple.developer.driverkit.transport.usb
	    com.apple.developer.driverkit.userclient-access (array: org.provenance-emu.provenance, org.provenance-emu.ProvenanceCompanion)
	-->

	<!-- App sandbox (required for DriverKit extensions on iPadOS) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
