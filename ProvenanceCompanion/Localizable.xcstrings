    "peripherals.driverkit.description" : {
      "comment" : "Footer describing what the DriverKit extension does",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The DriverKit extension enables USB gamepads and peripherals not natively supported by iPadOS, including DualShock 3 and GameCube adapters. Once active, all apps on your device benefit."
          }
        }
      }
    },
