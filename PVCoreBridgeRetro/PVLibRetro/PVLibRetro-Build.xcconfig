// Codesigning settings defined optionally, see `CodeSigning.xcconfig.example`
#include "../../Build.xcconfig"


// All
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) __LIBRETRO__=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_THREADS=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_OPENGL=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_OPENGLES=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_OPENGLES2=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_OPENGLES3=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_VULKAN=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_GLSL=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GLES=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GLES2=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GLES3=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) GLES31=1

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_CHEEVOS=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_RCHEEVOS=1

// HAVE_RCHEEVOS gates `#include "rc_client.h"` in PVThinLibretroFrontend.mm.
// SPM builds get the include path automatically via the CRcheevos product;
// the Xcode workspace path needs the search path explicitly. PVRcheevos is
// a sibling SPM package; its public headers live under rcheevos/include.
//
// NOTE: $(SRCROOT) here is the consuming xcodeproj's source root (i.e.
// `PVCoreBridgeRetro/` when this xcconfig is included from
// PVCoreBridgeRetro.xcodeproj), NOT this xcconfig file's location. That's
// why we go up only one level — `../PVRcheevos/...` — to reach the sibling
// PVRcheevos package at the repo root.
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/../PVRcheevos/rcheevos/include
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_NETPLAY=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_NETWORK=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_CODEC_HW=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_NETWORKING=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_STDIN_CMD=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_COMMAND
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_NETWORK_CMD=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_DYNAMIC=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_THREADS=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_NETWORKGAMEPAD=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_ZLIB=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_ZARCH=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_GIT_VERSION=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_COMPRESSION=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_COREAUDIO
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_DYLIB=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_COCOA=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_CORELOCATION
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_COCOATOUCH
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_LOCATION=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_CAMERA=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_HID=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_7ZIP
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_FFMPEG
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_LIBRETRODB
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_CORETEXT
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_AVFOUNDATION
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_CDROM
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_PATCH
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_RPNG
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_RBMP
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_GFX_WIDGETS
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_OVERLAY
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_FILTERS_BUILTIN

// GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HAVE_PLAIN_DRM=1

OTHER_CFLAGS = $(inherited) -ObjC
OTHER_LDFLAGS = $(inherited) -ObjC -all_load

    // Device
GCC_PREPROCESSOR_DEFINITIONS[sdk=iphoneos*] = $(inherited) TARGET_IPHONE=1
OTHER_CFLAGS[sdk=iphoneos*] = $(inherited)

// Simulator
GCC_PREPROCESSOR_DEFINITIONS[sdk=iphonesimulator*] = $(inherited) TARGET_IPHONE_SIMULATOR=1

// tvOS Device
GCC_PREPROCESSOR_DEFINITIONS[sdk=appletvos*] = $(inherited) TARGET_IPHONE=1
OTHER_CFLAGS[sdk=appletvos*] = $(inherited)

// tvOS Simulator
GCC_PREPROCESSOR_DEFINITIONS[sdk=appletvsimulator*] = $(inherited) TARGET_IPHONE_SIMULATOR=1
