# Provenance local secrets — copy to .env (gitignored) and fill in.
# The Makefile auto-loads .env and exports everything to recipes, so
# `make testflight`, release.sh and fastlane all see these.
#
# Sync helper: Scripts/secrets-1p.sh (1Password <-> .env <-> GitHub secrets).
# GitHub secrets are WRITE-ONLY — nothing can read them back; this file is the
# local source of truth, 1Password is the durable backup.

# ── App Store Connect API ────────────────────────────────────────────────
# Where: https://appstoreconnect.apple.com → Users and Access → Integrations
#        → App Store Connect API → Team Keys.
# Issuer ID is shown at the top of that page (a UUID).
# Key ID is per-key; the .p8 downloads ONCE — keep it in
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 (release.sh auto-finds it there).
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
# Optional: explicit path; release.sh falls back to ~/.appstoreconnect/private_keys.
ASC_API_KEY_PATH=
# CI only (secret ASC_API_KEY_CONTENT): base64 of the .p8 —
#   base64 -i ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 | pbcopy

# ── Code signing (CI) ────────────────────────────────────────────────────
# CERT_P12: base64 of the Apple Distribution certificate exported as .p12:
#   Keychain Access → My Certificates → "Apple Distribution: …" → right-click
#   → Export → .p12 with a password, then: base64 -i cert.p12 | pbcopy
# P12_PASS: the password you chose during export.
# SIGNING_IDENTITY: the certificate common name, e.g. "Apple Distribution: Joseph Mattiello (S32Z3HMYVQ)"
#   list yours: security find-identity -v -p codesigning
CERT_P12=
P12_PASS=
SIGNING_IDENTITY=

# ── GitHub PATs ──────────────────────────────────────────────────────────
# DYLIBS_TOKEN: PAT with `repo` scope that can read Provenance-Emu/provenance-dylibs.
#   Create: https://github.com/settings/tokens → Fine-grained → repo access to
#   provenance-dylibs (+ provenance-media) → Contents: Read (Read/Write to upload).
# WEBSITE_DISPATCH_TOKEN: PAT that can `repository_dispatch` the website repo.
# PAGES_DEPLOY_KEY: deploy key for the site (only needed for site publishing).
DYLIBS_TOKEN=
WEBSITE_DISPATCH_TOKEN=

# ── Integrations (optional, CI features degrade gracefully without) ──────
# DISCORD_WEBHOOK: Discord server → Server Settings → Integrations → Webhooks.
# ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN: console.anthropic.com / `claude setup-token`.
DISCORD_WEBHOOK=
ANTHROPIC_API_KEY=

# ── Fastlane environment (used by fastlane/Appfile) ──────────────────────
APPLE_ID=
ITC_TEAM_ID=
DEV_TEAM_ID=
DEV_DOMAIN=org.provenance-emu
